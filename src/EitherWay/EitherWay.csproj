<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>EitherWay</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <PackageId>EitherWay</PackageId>
    <Version>1.0.0</Version>
    <Authors>Hancer Mercede</Authors>
    <Description>Functional error handling for C#. Railway-oriented programming with the Either monad.</Description>
    <PackageTags>either;functional;railway;monad;error-handling;csharp</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

</Project>
