<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>EitherWay.Http</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <PackageId>EitherWay.Http</PackageId>
    <Version>1.0.0</Version>
    <Authors>Hancer Mercede</Authors>
    <Description>ASP.NET Core integration for EitherWay. Map Either results to HTTP responses with zero boilerplate.</Description>
    <PackageTags>either;functional;aspnetcore;webapi;error-handling</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\EitherWay\EitherWay.csproj" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
